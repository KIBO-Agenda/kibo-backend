# App
APP_NAME=Agenda Backend
DEBUG=false
API_V1_PREFIX=/api/v1

# Environment
ENVIRONMENT=development

# Database (SQLAlchemy URL)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agenda

# Security / JWT
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Evolution API / WhatsApp
# Preferred names
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=kibo-dev-key
# Backend base URL used to build default Evolution webhook callback URL
BACKEND_BASE_URL=http://127.0.0.1:8000
# Optional explicit callback URL override
# EVOLUTION_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/webhooks/whatsapp
# Backward-compatible names (optional)
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=kibo-dev-key

# Super admin seed (optional)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
